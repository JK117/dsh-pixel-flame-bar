{
  "name": "dsh-pixel-flame-bar",
  "version": "0.1.0",
  "private": true,
  "description": "DSH sidebar pixel flame bar: transparent grid, blue-to-white sparkles in dark mode, deep-to-soft blue in light mode, and a 5-second light-up on click.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "open preview/index.html",
    "preview:light": "open preview/light.html",
    "test": "node scripts/smoke-test.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
