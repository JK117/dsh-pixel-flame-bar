{
  "name": "dsh-pixel-flame-bar",
  "version": "0.1.0",
  "private": true,
  "description": "DSH sidebar pixel flame bar: a transparent pixel array above the account row that flickers while any session runs, lights up for five seconds on click, and follows the dark and light themes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "open preview/index.html",
    "preview:light": "open preview/light.html",
    "test": "node scripts/smoke-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
