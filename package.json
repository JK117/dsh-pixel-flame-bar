{
  "name": "dsh-plugin-session-lightbar",
  "version": "0.1.0",
  "private": true,
  "description": "Sidebar transparent pixel array: a DeepSeek-blue grid when idle, random blue-to-white sparkles while a session runs, and a 5-second light-up on click.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "open preview/index.html",
    "test": "node scripts/smoke-test.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
